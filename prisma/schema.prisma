// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite" 
  url      = "file:./dev.db" 
}

// prisma/schema.prisma

model Company {
  id              String    @id @default(uuid())
  name            String    @unique
  legalName       String?   // නීතිමය නම (LLC, Inc. වගේ)
  address         String?
  city            String?
  country         String?
  phone           String?
  email           String?
  website         String?
  currency        String    @default("LKR") // POS transactions වලට අවශ්‍ය මුදල් වර්ගය
  isActive        Boolean   @default(true)  // Company එක active ද නැද්ද කියලා
  users           User[]    // Company එකට අයිති users
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(USER)
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  permissions  Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  USER
}